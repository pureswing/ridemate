{
  "expo": {
    "name": "BoteGo",
    "slug": "ridemate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "botego",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFAF5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.botego.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BoteGo usa tu ubicación para mostrarte viajes cerca de ti.",
        "NSLocationAlwaysUsageDescription": "BoteGo usa tu ubicación para mostrarte viajes cerca de ti."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFAF5"
      },
      "package": "com.botego.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#FFFAF5"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFAF5"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#D9B871"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa7277a3-781d-4d0d-afb1-a7264280b812"
      }
    },
    "owner": "pureswing"
  }
}
